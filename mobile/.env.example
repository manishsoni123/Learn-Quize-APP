# Copy to .env and fill in from your Supabase dashboard:
#   Project Settings → API
#
# Both values are safe to ship inside the app. The anon key is public by
# design — Row Level Security is what protects the data, not this string.
# Restart the dev server after editing; Expo reads env files at startup.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
